<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <solid android:color="#FF161A22" />
            <stroke android:width="1dp" android:color="#FF2A303C" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <solid android:color="#FF4A1626" />
            <stroke android:width="1dp" android:color="#FFFF5370" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <solid android:color="#CC2A1218" />
            <stroke android:width="1dp" android:color="#66FF5370" />
        </shape>
    </item>
</selector>
